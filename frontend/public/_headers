# Data JSONs are regenerated by every crawl. Without an explicit policy
# browsers apply heuristic caching (percentage of Last-Modified age), which
# let the home page serve week-old data (stuck-at-2026-07-24 incident).
# 60s + must-revalidate keeps edge/browser fresh; ETag 304s keep it cheap.
/data/*
  Cache-Control: public, max-age=60, must-revalidate

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.firebaseapp.com https://*.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.firestore.googleapis.com https://firestore.googleapis.com https://www.googleapis.com https://insurance-kb-api.alan-chen75.workers.dev https://gemgate.cooperation.tw; frame-src https://cooperation-hub-bfe79.firebaseapp.com https://accounts.google.com https://apis.google.com; frame-ancestors 'none'
  X-XSS-Protection: 1; mode=block
